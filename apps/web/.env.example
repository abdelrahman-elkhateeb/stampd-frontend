# Copy to .env.local for local development: cp .env.example .env.local

# Server only. Base URL of the Stampd API that the Next.js server (BFF) calls.
API_BASE_URL=http://localhost:4000
# true while API_BASE_URL is the local mock API (pnpm mock); shows the demo accounts on login.
API_MOCKING=true

# local | preview | staging | production
NEXT_PUBLIC_APP_ENV=local

# Optional. Error monitoring; leave empty to disable Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build only (CI / Vercel): uploads source maps. Never commit a real value.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
